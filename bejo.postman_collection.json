{
  "info": {
    "name": "Bejo API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "{{prodUrl}}",
      "type": "string",
      "description": "Active base URL used by every request. Switch environments by setting this to {{prodUrl}} or {{localUrl}}."
    },
    {
      "key": "localUrl",
      "value": "http://localhost:8080",
      "type": "string",
      "description": "Local dev server (docker compose / mvn spring-boot:run)."
    },
    {
      "key": "prodUrl",
      "value": "https://api.bejo.temanproduk.com",
      "type": "string",
      "description": "Production (Cloud Run, us-central1). Until the custom domain's DNS/SSL is live, use the direct Cloud Run URL https://bejo-7d3jwuvixa-uc.a.run.app instead."
    },
    {
      "key": "apiToken",
      "value": "REPLACE_WITH_YOUR_API_TOKEN",
      "type": "string",
      "description": "Matches API_TOKEN in .env — set this locally, do NOT commit the real value. Sent as X-API-TOKEN header on every request."
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "JWT Bearer token — auto-populated by the Login request test script"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-TOKEN", "value": "{{apiToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"alice\",\n  \"password\": \"Secret1\",\n  \"name\": \"Alice\",\n  \"email\": \"alice@example.com\",\n  \"phone\": \"+628100000000\",\n  \"businessName\": \"Alice Shop\",\n  \"businessAddress\": \"Jl. Contoh No. 1\",\n  \"nmid\": \"ID1026540778978\",\n  \"bankName\": \"Bank BCA\",\n  \"bankNumber\": \"1234567890\",\n  \"bankAccountName\": \"Alice\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "register"]
            },
            "description": "Self-service registration. Creates a SELF_SERVICE user + bank profile. No JWT required — only X-API-TOKEN. No QRIS row is created (QRIS is optional; add one later via /api/qris/upload).\n\nMandatory: username, password, name, email, phone, businessName.\nOptional: businessAddress, nmid, bankName, bankNumber, bankAccountName.\n\nReturns HTTP 201 on success."
          }
        },
        {
          "name": "Register (internal — MANAGED)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-TOKEN", "value": "{{apiToken}}" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"managed_user\",\n  \"password\": \"Secret1\",\n  \"name\": \"Managed User\",\n  \"email\": \"managed@example.com\",\n  \"phone\": \"+628100000001\",\n  \"businessName\": \"Managed Shop\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/internal/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "internal", "register"]
            },
            "description": "Internal/system registration. Same payload as public registration but creates a MANAGED account. Requires a valid JWT (Authorization: Bearer) in addition to X-API-TOKEN — it is not public.\n\nReturns HTTP 201 on success."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.status === 1 && res.data && res.data.token) {",
                  "    pm.collectionVariables.set('token', res.data.token);",
                  "    console.log('JWT saved to {{token}}');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-TOKEN", "value": "{{apiToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"password\",\n  \"deviceId\": \"device-001\",\n  \"pushToken\": \"fcm-token-here\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Authenticate with username + password. The test script auto-saves the JWT to `{{token}}`.\n\nResponse includes: username, accountType, name, email, isEmailVerified, phone, isPhoneVerified, businessName, businessAddress, nmid, bankName, bankNumber, bankAccountName, token, tokenType."
          }
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('token', '');",
                  "    console.log('Token cleared from {{token}}');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-TOKEN", "value": "{{apiToken}}" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            },
            "description": "Invalidates the current JWT — it cannot be used again after logout. The test script clears `{{token}}` from the collection variables."
          }
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "Get Transaction History",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-TOKEN", "value": "{{apiToken}}" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions"],
              "query": [
                {
                  "key": "dateStart",
                  "value": "",
                  "description": "Filter start date (inclusive), format: yyyy-MM-dd. Optional.",
                  "disabled": true
                },
                {
                  "key": "dateEnd",
                  "value": "",
                  "description": "Filter end date (inclusive), format: yyyy-MM-dd. Optional.",
                  "disabled": true
                }
              ]
            },
            "description": "Returns transaction history for the authenticated user, ordered by date descending.\n\nEach transaction includes: transactionId, transactionDate, amount (integer), type (MANAGED/MANUAL/PARSED), acquirer, issuerName, merchantName, merchantPan (optional), customerPan (optional), rrn (optional).\n\nOptional date filter: dateStart and/or dateEnd (format yyyy-MM-dd, both inclusive)."
          }
        },
        {
          "name": "Add Transaction (Manual)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-TOKEN", "value": "{{apiToken}}" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}", "description": "UUID per request attempt. Sending the same key again returns the existing transactionId without inserting a duplicate." }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"MANUAL\",\n  \"transactionDate\": \"2026-06-29T10:00:00\",\n  \"amount\": 50000,\n  \"issuerName\": \"Cash\",\n  \"rrn\": \"000100000099\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions"]
            },
            "description": "Manually records a transaction. The server generates transactionId.\n\nIdempotency-Key header is required — use a UUID per request attempt. Resubmitting the same key returns the same transactionId without inserting a duplicate.\n\nFor MANUAL type, acquirer is automatically set to 'Cash'.\nMandatory: type, transactionDate, amount.\nOptional: issuerName, merchantPan, customerPan, rrn.\n\nReturns HTTP 201 with { transactionId }."
          }
        },
        {
          "name": "Add Transaction (Parsed)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-TOKEN", "value": "{{apiToken}}" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}", "description": "UUID per request attempt. Sending the same key again returns the existing transactionId without inserting a duplicate." }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"PARSED\",\n  \"transactionDate\": \"2026-06-29T09:14:00\",\n  \"amount\": 75000,\n  \"issuerName\": \"GoPay\",\n  \"acquirer\": \"Midtrans\",\n  \"merchantPan\": \"936009XXXXXX0001\",\n  \"customerPan\": \"401177XXXXXX5678\",\n  \"rrn\": \"000100000001\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions"]
            },
            "description": "Records a transaction from an external acquirer. The server generates transactionId.\n\nIdempotency-Key header is required. For PARSED type, acquirer is required.\n\nReturns HTTP 201 with { transactionId }."
          }
        },
        {
          "name": "Bulk Create (offline sync)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-TOKEN", "value": "{{apiToken}}" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactions\": [\n    {\n      \"idempotencyKey\": \"off-1\",\n      \"transaction\": {\n        \"type\": \"MANUAL\",\n        \"transactionDate\": \"2026-06-28T09:14:00\",\n        \"amount\": 10000\n      }\n    },\n    {\n      \"idempotencyKey\": \"off-2\",\n      \"transaction\": {\n        \"type\": \"PARSED\",\n        \"transactionDate\": \"2026-06-28T10:00:00\",\n        \"amount\": 20000,\n        \"acquirer\": \"AstraPay\"\n      }\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/transactions/bulk",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "bulk"]
            },
            "description": "Bulk-create manually-entered transactions synced after offline entry. Each item has its own idempotencyKey (client-generated) so re-sending the batch never duplicates. Partial success: one bad item does not block the rest.\n\nReturns HTTP 200 with a summary (total/created/duplicate/failed) and a per-item results list; match each result back by idempotencyKey. Item status is CREATED, DUPLICATE (already synced), or FAILED (with error). Batch limits: 1–500 items."
          }
        },
        {
          "name": "Edit Transaction",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "X-API-TOKEN", "value": "{{apiToken}}" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 60000,\n  \"issuerName\": \"OVO\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/transactions/:transactionId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", ":transactionId"],
              "variable": [
                { "key": "transactionId", "value": "TXN-XXXXXXXXXXXX", "description": "transactionId returned by Add Transaction / history" }
              ]
            },
            "description": "Edits the authenticated user's transaction. Partial update — only fields present in the body are changed; type cannot be changed. Only MANUAL/PARSED transactions can be edited — MANAGED ones are immutable.\n\nOptional fields (send at least one): transactionDate, amount, acquirer, issuerName, merchantPan, customerPan, rrn.\n\nReturns HTTP 200 with the updated transaction.\nErrors: 400 (no fields / MANAGED type / invalid amount / blank acquirer), 404 Transaction not found (unknown, deleted, or another user's transaction)."
          }
        },
        {
          "name": "Delete Transaction",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "X-API-TOKEN", "value": "{{apiToken}}" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/transactions/:transactionId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", ":transactionId"],
              "variable": [
                { "key": "transactionId", "value": "TXN-XXXXXXXXXXXX", "description": "transactionId returned by Add Transaction / history" }
              ]
            },
            "description": "Soft-deletes the authenticated user's transaction: the row keeps a deleted_at timestamp and disappears from history. Cannot be undone via the API.\n\nReturns HTTP 200.\nErrors: 404 Transaction not found (unknown, already deleted, or another user's transaction)."
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "Send Test Notification",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-TOKEN", "value": "{{apiToken}}" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"da8221950b5d5c15\",\n  \"title\": \"Uang masuk Rp 50.000\",\n  \"body\": \"Ada transaksi masuk sejumlah Rp 50.000\",\n  \"data\": {\n    \"transactionId\": \"TXN-A1B2C3D4\",\n    \"transactionDate\": \"2026-06-29T09:14:00\",\n    \"amount\": 50000,\n    \"issuerName\": \"GoPay\",\n    \"merchantPan\": \"936009XXXXXX0001\",\n    \"customerPan\": \"401177XXXXXX5678\",\n    \"rrn\": \"000100000001\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/notifications/test",
              "host": ["{{baseUrl}}"],
              "path": ["api", "notifications", "test"]
            },
            "description": "TEST endpoint — sends an FCM push notification (built from this payload) to the specified device. Does NOT record any transaction.\n\ndata.transactionId, data.transactionDate, data.amount, and data.issuerName are required. merchantPan, customerPan, and rrn are optional.\n\nRequires Firebase to be configured (503 if not). Real payments are recorded and pushed by the QRIS Callback (QR MPM Notify)."
          }
        }
      ]
    },
    {
      "name": "Devices",
      "item": [
        {
          "name": "Update FCM Token",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "X-API-TOKEN", "value": "{{apiToken}}" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pushToken\": \"new-fcm-token-here\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/devices/device-001/fcm-token",
              "host": ["{{baseUrl}}"],
              "path": ["api", "devices", "device-001", "fcm-token"]
            },
            "description": "Updates the FCM push token for a device. Replace `device-001` in the path with the actual device ID."
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Update Profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "X-API-TOKEN", "value": "{{apiToken}}" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Wonderland\",\n  \"email\": \"alice@example.com\",\n  \"phone\": \"+628100000000\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me"]
            },
            "description": "Updates name, email, and phone. All three fields are required.\n\nPhone must be in international format, e.g. +628123456789."
          }
        },
        {
          "name": "Update Business Info",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "X-API-TOKEN", "value": "{{apiToken}}" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"businessName\": \"Alice Shop New\",\n  \"businessAddress\": \"Jl. Baru No. 2\",\n  \"nmid\": \"ID1026540778978\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/me/business",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me", "business"]
            },
            "description": "Updates the display business name, address, and NMID. businessName is required; businessAddress and nmid are optional.\n\nDoes NOT change the initial (regulatory) values. Use Reset Business Info to revert."
          }
        },
        {
          "name": "Reset Business Info",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-TOKEN", "value": "{{apiToken}}" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me/business/reset",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me", "business", "reset"]
            },
            "description": "Reverts businessName, businessAddress, and nmid to the values recorded at registration.\n\nNo request body needed."
          }
        },
        {
          "name": "Update Bank Info",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "X-API-TOKEN", "value": "{{apiToken}}" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bankName\": \"Bank BCA\",\n  \"bankNumber\": \"1234567890\",\n  \"bankAccountName\": \"Alice\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/me/bank",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me", "bank"]
            },
            "description": "Updates bank account information. All three fields are required.\n\nbankNumber must be digits only, 6–20 digits.\n\nDoes NOT change the initial (regulatory) values. Use Reset Bank Info to revert."
          }
        },
        {
          "name": "Reset Bank Info",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-TOKEN", "value": "{{apiToken}}" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me/bank/reset",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me", "bank", "reset"]
            },
            "description": "Reverts bankName, bankNumber, and bankAccountName to the values recorded at registration (initialBankName / initialBankNumber / initialBankAccountName).\n\nNo request body needed."
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "X-API-TOKEN", "value": "{{apiToken}}" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldPassword\": \"Secret1\",\n  \"newPassword\": \"NewSecret2\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/me/password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me", "password"]
            },
            "description": "Changes the authenticated user's password. Requires the current password for verification.\n\nnewPassword rules: minimum 8 characters, at least 1 letter and 1 number."
          }
        },
        {
          "name": "Get Profile Picture",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-TOKEN", "value": "{{apiToken}}" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me/profile-picture",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me", "profile-picture"]
            },
            "description": "Returns the user's profile picture as a base64 string. Optional — when unset, data.profilePicture is explicitly null (no placeholder)."
          }
        },
        {
          "name": "Set Profile Picture",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "X-API-TOKEN", "value": "{{apiToken}}" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"profilePicture\": \"iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+M8AAAMFAgD5wKq2AAAAAElFTkSuQmCC\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/me/profile-picture",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me", "profile-picture"]
            },
            "description": "Stores a base64-encoded image as the profile picture. Compress client-side; the decoded image must be <= 1 MB. Returns the saved picture."
          }
        },
        {
          "name": "Delete Profile Picture",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "X-API-TOKEN", "value": "{{apiToken}}" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me/profile-picture",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me", "profile-picture"]
            },
            "description": "Clears the user's profile picture (sets it back to null). Idempotent — succeeds whether or not a picture was set."
          }
        }
      ]
    },
    {
      "name": "Products & Categories",
      "item": [
        {
          "name": "Create Category",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-TOKEN", "value": "{{apiToken}}" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Minuman\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories"]
            },
            "description": "Creates a product category (unique name per merchant). Returns HTTP 201 with { id, name, createdAt }."
          }
        },
        {
          "name": "List Categories",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-TOKEN", "value": "{{apiToken}}" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories"]
            },
            "description": "Lists the merchant's product categories."
          }
        },
        {
          "name": "Delete Category",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "X-API-TOKEN", "value": "{{apiToken}}" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/categories/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "categories", "1"]
            },
            "description": "Deletes a category. Its products are un-categorized (categoryId -> null), not deleted. Replace 1 with the category id."
          }
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-TOKEN", "value": "{{apiToken}}" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"KOPI-01\",\n  \"name\": \"Kopi Susu\",\n  \"shortDescription\": \"Kopi + susu segar\",\n  \"categoryId\": 1,\n  \"price\": 18000,\n  \"costPrice\": 10000,\n  \"stock\": 25,\n  \"photo\": \"iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+M8AAAMFAgD5wKq2AAAAAElFTkSuQmCC\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            },
            "description": "Creates a product (SKU). sku + name required; sku unique per merchant. categoryId (optional) must be one of the merchant's own categories. photo (optional) is a base64 image, max 500 KB decoded. Returns HTTP 201 with the product incl. resolved categoryName."
          }
        },
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-TOKEN", "value": "{{apiToken}}" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products?categoryId=1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "categoryId", "value": "1", "description": "Optional filter by category id", "disabled": true }
              ]
            },
            "description": "Lists the merchant's products. Optional ?categoryId= filter. The photo field is omitted from list items to keep the payload small — use Get Product for the image."
          }
        },
        {
          "name": "Get Product",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-TOKEN", "value": "{{apiToken}}" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "1"]
            },
            "description": "Returns one product including its photo. Replace 1 with the product id."
          }
        },
        {
          "name": "Update Product (incl. stock)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "X-API-TOKEN", "value": "{{apiToken}}" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 20000,\n  \"stock\": 40\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "1"]
            },
            "description": "Partial update: send any subset of sku, name, categoryId, price, costPrice, stock, photo. Managing inventory = send { \"stock\": N }. Replace 1 with the product id."
          }
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "X-API-TOKEN", "value": "{{apiToken}}" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "1"]
            },
            "description": "Hard-deletes a product. Replace 1 with the product id."
          }
        },
        {
          "name": "Bulk Stock Adjustment (opname)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-TOKEN", "value": "{{apiToken}}" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"productId\": 1, \"stock\": 8 },\n    { \"productId\": 2, \"stock\": 12 }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/products/stock-adjustments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "stock-adjustments"]
            },
            "description": "Stock opname: sets several products' stock to their newly counted quantities at once. Each item's stock is the new absolute count. Atomic — if any productId isn't the merchant's, the whole adjustment is rejected. Returns a variance report (previousStock/newStock/difference) per product."
          }
        }
      ]
    },
    {
      "name": "Stock Mutations",
      "item": [
        {
          "name": "Record Purchase (restock)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-TOKEN", "value": "{{apiToken}}" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"restock pagi\",\n  \"items\": [\n    { \"productId\": 1, \"quantity\": 20 },\n    { \"productId\": 2, \"quantity\": 5, \"unitPrice\": 9000 }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/stock-mutations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stock-mutations"]
            },
            "description": "Records a PURCHASE (restock) stock mutation: raises the stock of every listed product at once and saves line items with before/after stock. Atomic — if any productId isn't the merchant's, the whole thing is rejected. unitPrice defaults to the product's costPrice when omitted. Returns HTTP 201 with type=PURCHASE, totalAmount + item snapshots."
          }
        },
        {
          "name": "List Stock Mutations (history)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-TOKEN", "value": "{{apiToken}}" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/stock-mutations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stock-mutations"]
            },
            "description": "Stock-change history newest-first — all mutations (PURCHASE from restock, ADJUSTMENT from stock opname, UPDATE from a product edit that changed stock). Line items omitted; use Get Stock Mutation for detail."
          }
        },
        {
          "name": "Get Stock Mutation",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-TOKEN", "value": "{{apiToken}}" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/stock-mutations/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stock-mutations", "1"]
            },
            "description": "Returns one stock mutation including its line items (previousStock/newStock/quantityChange). Replace 1 with the mutation id."
          }
        }
      ]
    },
    {
      "name": "App Settings",
      "item": [
        {
          "name": "Get App Settings",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-TOKEN", "value": "{{apiToken}}" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/app-settings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "app-settings"]
            },
            "description": "Returns the user's app settings (monitored apps + notification keyword filters). When nothing has been synced yet, returns defaults: empty monitoredApps/keyword lists, blacklistEnabled=true, whitelistEnabled=false."
          }
        },
        {
          "name": "Save Monitored Apps",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "X-API-TOKEN", "value": "{{apiToken}}" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
