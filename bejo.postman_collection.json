    },
    {
      "name": "QRIS",
      "item": [
        {
          "name": "Get QRIS",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-API-TOKEN", "value": "{{apiToken}}" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/qris",
              "host": ["{{baseUrl}}"],
              "path": ["api", "qris"]
            },
            "description": "Returns the QRIS image as base64 and business info for the authenticated user.\n\nResponse includes: type (MANAGED or UPLOADED), image (base64-encoded PNG), businessName, businessAddress, nmid.\n\nIf no image has been generated yet, one is created and stored on the first call.\n\ntype=MANAGED means the Bejo-generated QRIS. type=UPLOADED means the user has uploaded their own QRIS image which takes precedence."
          }
        },
        {
          "name": "Upload QRIS",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-TOKEN", "value": "{{apiToken}}" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"qrisImage\": \"<base64-encoded image string>\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/qris/upload",
              "host": ["{{baseUrl}}"],
              "path": ["api", "qris", "upload"]
            },
            "description": "Uploads a custom QRIS image. After uploading, GET /api/qris returns this image with type=UPLOADED.\n\nThe generated QRIS is preserved and can be restored with Reset QRIS.\n\nqrisImage must be a valid base64-encoded string."
          }
        },
        {
          "name": "Reset QRIS",
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-API-TOKEN", "value": "{{apiToken}}" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/qris/reset",
              "host": ["{{baseUrl}}"],
              "path": ["api", "qris", "reset"]
            },
            "description": "Clears the uploaded QRIS image and reverts to the Bejo-generated one (type=MANAGED).\n\nNo request body needed."
          }
        }
      ]
    },
    {
      "name": "QRIS Callback",
      "item": [
        {
          "name": "QR MPM Notify",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-TIMESTAMP", "value": "2020-12-23T08:46:11+07:00" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"originalReferenceNo\": \"XCBS6Z450S\",\n  \"originalPartnerReferenceNo\": \"DEV20250826422460\",\n  \"latestTransactionStatus\": \"00\",\n  \"transactionStatusDesc\": \"SUCCESS\",\n  \"customerNumber\": \"9360082230250015792\",\n  \"destinationNumber\": \"9360082232504524231\",\n  \"destinationAccountName\": \"Asep & Testing\",\n  \"externalStoreId\": null,\n  \"amount\": { \"value\": \"100.00\", \"currency\": \"IDR\" },\n  \"additionalInfo\": {\n    \"tip\": \"0.00\",\n    \"deviceId\": \"AstraPay\",\n    \"channel\": \"POS\",\n    \"terminalId\": \"5164\",\n    \"userName\": \"AstraPay User\",\n    \"merchantPan\": \"9360082232504524231\",\n    \"customerPan\": \"9360082230250015792\",\n    \"issuerName\": \"93600822\",\n    \"transactionId\": \"INV/QRM/4542BR/250826/2G4Y6CCZ\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/snap/v1.0/qr/qr-mpm-notify",
              "host": ["{{baseUrl}}"],
              "path": ["snap", "v1.0", "qr", "qr-mpm-notify"]
            },
            "description": "Inbound QRIS payment callback (SNAP-like QR MPM notify) from the QRIS merchant service (e.g. AstraPay). Server-to-server — no X-API-TOKEN and no JWT.\n\nRecords the payment as a MANAGED transaction and stores the raw payload in the transaction's additional_info column. Routed to the Bejo user whose nmid == merchantPan (else app.callback.default-username). Idempotent on originalReferenceNo + originalPartnerReferenceNo.\n\nReturns HTTP 200 with the acknowledgment shape { id, billNumber, referenceNumber, amount, tip, status, createdAt } — NOT the standard envelope."
          }
        }
      ]
    },
