# VM deployment config (Tencent Cloud, Docker Compose) — copy to .env.vm and fill in.
# .env.vm is gitignored (it holds secrets). Used by scripts/init-vm.sh and scripts/deploy-vm.sh.
#
# This file is sourced by bash: QUOTE any value containing spaces, & or other shell
# characters (e.g. SEED_NAME="Admin User"). Single quotes can't appear in a value.
# Variables starting with VM_ stay on your machine; everything else (non-empty) is written
# to the VM as the app's .env. A setting left blank or commented out uses the app's default.

# --- The VM ---
VM_HOST=                      # public IP or hostname
# Who the scripts SSH in as. Setup order: VM_USER=root for init-vm.sh and harden-vm.sh (root
# login is closed by harden-vm.sh), then change it to the deploy user (VM_DEPLOY_USER below).
VM_USER=root
# VM_SSH_PORT=22
# VM_SSH_KEY=~/.ssh/id_ed25519   # blank = ssh's default key
# The unprivileged account that owns the app and runs deploys (created by init-vm.sh). It has
# no password and no sudo — it can only log in with a key. Default: deploy (when VM_USER=root).
# VM_DEPLOY_USER=deploy
# Your public key, authorized for that account. Default: VM_SSH_KEY's .pub, else ~/.ssh/id_ed25519.pub
# VM_DEPLOY_PUBKEY=~/.ssh/id_ed25519.pub
# Public key of the GitHub Actions deploy key (optional). Authorized with `restrict`, so it can
# run the deploy commands but not forward ports or open a terminal.
# VM_CI_PUBKEY=~/.ssh/bejo_deploy.pub
# harden-vm.sh closes root SSH login. Set to prohibit-password to keep key-only root login
# (needs a key in /root/.ssh/authorized_keys) so you can re-run admin scripts without the console.
# VM_ROOT_LOGIN=no
# VM_APP_DIR=bejo                # install dir, relative to the VM user's home
# Only for init-vm.sh, e.g. in mainland China where get.docker.com / Docker Hub are slow:
# VM_DOCKER_INSTALL_MIRROR=Aliyun
# VM_DOCKER_REGISTRY_MIRROR=https://mirror.ccs.tencentyun.com

# --- Public address ---
# DNS A record for this name must point at the VM, with inbound 80 + 443 open, so Caddy can
# get a Let's Encrypt certificate.
DOMAIN=api.example.com

# --- Database (Postgres runs in a container on the VM) ---
DB_NAME=bejo
DB_USERNAME=bejo
# Only applied when the data volume is first created; changing it later also needs
# ALTER USER inside Postgres. Generate: openssl rand -hex 24
DB_PASSWORD=

# --- Secrets ---
API_TOKEN=                    # shared X-API-TOKEN. Generate: openssl rand -hex 32
JWT_SECRET=                   # base64, min 256 bits: openssl rand -base64 32
FIREBASE_CREDENTIALS_BASE64=  # base64-encoded service account JSON

# --- Seed user (created on first startup; skipped when SEED_PASSWORD is empty) ---
SEED_USERNAME=admin
SEED_PASSWORD=
SEED_NAME="Admin User"
SEED_BUSINESS_NAME="My Business"
SEED_BUSINESS_ADDRESS=
SEED_NMID=
SEED_MERCHANT_PAN=

# --- Optional overrides (built-in defaults apply if unset) ---
# JWT_EXPIRATION_MS=604800000
# BUSINESS_MAX_USERS=10
# BUSINESS_SIZES="Mikro,Kecil,Menengah,Besar,Non-Profit"
# BUSINESS_DEFAULT_SIZE=Mikro
# BUSINESS_INDUSTRIES="Makanan & Minuman,Otomotif,Event & Hiburan,Alat Tulis/Kantor,Peralatan Rumah Tangga,Pakaian & Aksesoris,Kesehatan & Kecantikan,Layanan Keuangan,SPBU,Pendidikan,Asuransi"
# BUSINESS_DEFAULT_INDUSTRY="Makanan & Minuman"
# CALLBACK_DEFAULT_USERNAME=admin
# A callback whose merchantPan is missing/unknown is rejected (404) by default; true restores
# attributing it to the default account.
# CALLBACK_FALLBACK_TO_DEFAULT=false
# LOGIN_MAX_FAILURES=10
# LOGIN_LOCKOUT_MINUTES=15
# MAX_REQUEST_BYTES=8388608
# DB_POOL_SIZE=10
# JAVA_OPTS=-XX:MaxRAMPercentage=75   # replaces the JVM flags
# PUSH_QUEUE_THREADS=4
# PUSH_QUEUE_CAPACITY=1000
# REQUEST_LOG_BODY_ON_ERROR=true
# REQUEST_LOG_MAX_BODY_LENGTH=2048

# --- QRIS callback ---
# Shared secret the payment provider must send as the X-Callback-Secret header on /snap/** callbacks;
# without it anyone who can reach that path can forge a payment notification. Generate: openssl rand -hex 32.
# If the provider can't send a header, restrict /snap/** to its source IPs in docker/Caddyfile instead.
CALLBACK_SECRET=

# --- Outgoing email: password reset codes (Zoho Mail SMTP) ---
# Leave MAIL_PASSWORD blank to keep password reset off (/api/auth/forgot-password answers 503).
# Host depends on the Zoho PLAN and data centre. US: smtp.zoho.com for FREE accounts, smtppro.zoho.com for PAID
# accounts (using the wrong one fails login with "554 5.7.8 Access Restricted"). Other data centres:
# smtp.zoho.eu / .in / .com.au / .jp (and smtppro.* for paid). Your own Settings -> Mail Accounts -> SMTP page is authoritative.
# 587 + STARTTLS is the default; for 465 set MAIL_PORT=465, MAIL_SSL=true, MAIL_STARTTLS=false.
# With two-factor authentication on the Zoho account use an APPLICATION-SPECIFIC password.
# MAIL_FROM must be the mailbox or one of its aliases. These ride along into the VM's .env.
MAIL_HOST=
MAIL_USERNAME=
MAIL_PASSWORD=
# MAIL_FROM=
# MAIL_FROM_NAME=Bejo
# MAIL_PORT=587

# --- Admin dashboard (https://dashboard.bejo.temanproduk.com) ---
# Comma-separated email addresses that may sign in with a one-time code emailed to them. Empty =
# nobody can sign in. Needs the MAIL_* settings above.
ADMIN_EMAILS=
# Browser origins allowed to call /api/admin/** (CORS). Default: https://dashboard.bejo.temanproduk.com
# ADMIN_DASHBOARD_ORIGINS=

# --- Voice ads ---
# Audio lives in a Google Cloud Storage bucket and needs Google credentials the VM doesn't
# have, so leave ADS_ADMIN_TOKEN blank (feature off) on this deployment.
# ADS_ADMIN_TOKEN=
