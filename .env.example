# Copy this to .env and fill in values

# Default user created on first startup (skipped if user already exists or SEED_PASSWORD is empty)
SEED_USERNAME=admin
SEED_PASSWORD=password
SEED_NAME=Anton
SEED_BUSINESS_NAME=Susilo
SEED_BUSINESS_ADDRESS=Jl. Contoh No. 1, Jakarta
SEED_NMID=ID1026540778978

# Shared API token — required on every request as X-API-TOKEN header
API_TOKEN=change-me-in-production

# JWT — generate a secure secret with: openssl rand -base64 32
JWT_SECRET=YmVqby1kZXYtc2VjcmV0LWtleS1tdXN0LWJlLWNoYW5nZWQtaW4tcHJvZHVjdGlvbi1taW4tMjU2Yml0cw==
JWT_EXPIRATION_MS=604800000

DB_URL=jdbc:postgresql://postgres:5432/bejo
DB_USERNAME=bejo
DB_PASSWORD=bejo

# Firebase — provide one of the two:
# Option 1: base64-encode your service account JSON: base64 -i service-account.json
FIREBASE_CREDENTIALS_BASE64=
# Option 2: mount the file and set the path
FIREBASE_CREDENTIALS_PATH=

SPRING_PROFILES_ACTIVE=prod

# ── Business options (all optional — the values below are the built-in defaults) ──
# Max users per business, INCLUDING the super admin
BUSINESS_MAX_USERS=10
# Allowed business sizes + industries (comma-separated), validated at registration.
# default-* is applied when the client omits the field and must be one of the list values.
BUSINESS_SIZES=Mikro,Kecil,Menengah,Besar,Non-Profit
BUSINESS_DEFAULT_SIZE=Mikro
BUSINESS_INDUSTRIES=Makanan & Minuman,Otomotif,Event & Hiburan,Alat Tulis/Kantor,Peralatan Rumah Tangga,Pakaian & Aksesoris,Kesehatan & Kecantikan,Layanan Keuangan,SPBU,Pendidikan,Asuransi
BUSINESS_DEFAULT_INDUSTRY=Makanan & Minuman

# ── Advanced (all optional — defaults shown) ──
# The seed user whose business PoC QRIS callbacks are attributed to (defaults to SEED_USERNAME)
CALLBACK_DEFAULT_USERNAME=
# Request-body logging on 4xx/5xx (secrets masked, capped)
REQUEST_LOG_BODY_ON_ERROR=true
REQUEST_LOG_MAX_BODY_LENGTH=2048
# HTTP port
SERVER_PORT=8080
