# Copy this to .env and fill in values

# Default user created on first startup (skipped if user already exists or SEED_PASSWORD is empty)
SEED_USERNAME=admin
SEED_PASSWORD=password
SEED_NAME=Admin User
SEED_BUSINESS_NAME=Admin Business
SEED_BUSINESS_ADDRESS=Jl. Contoh No. 1, Jakarta

# Shared API token — required on every request as X-API-TOKEN header
API_TOKEN=change-me-in-production

# JWT — generate a secure secret with: openssl rand -base64 32
JWT_SECRET=YmVqby1kZXYtc2VjcmV0LWtleS1tdXN0LWJlLWNoYW5nZWQtaW4tcHJvZHVjdGlvbi1taW4tMjU2Yml0cw==
JWT_EXPIRATION_MS=7776000000

DB_URL=jdbc:postgresql://postgres:5432/bejo
DB_USERNAME=bejo
DB_PASSWORD=bejo

# Firebase — provide one of the two:
# Option 1: base64-encode your service account JSON: base64 -i service-account.json
FIREBASE_CREDENTIALS_BASE64=
# Option 2: mount the file and set the path
FIREBASE_CREDENTIALS_PATH=

SPRING_PROFILES_ACTIVE=prod
