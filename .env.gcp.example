# GCP project configuration — copy to .env.gcp and fill in all values
# .env.gcp is gitignored (it contains sensitive values)

# NOTE: this file is sourced by bash. Quote any value with spaces or & (as below), or the
# scripts abort with "command not found".

# --- Project ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# --- Custom domain ---
# Must be verified in Google Search Console before running init-gcp.sh
# https://search.google.com/search-console
CUSTOM_DOMAIN=api.bejo.temanproduk.com

# --- GitHub Actions → GCP authentication (Workload Identity Federation, no key file) ---
# init-gcp.sh derives the repository from the git remote; set these only to override. CI can then
# deploy only from this repository's release branch.
# GITHUB_REPO=owner/repo
# GITHUB_DEPLOY_REF=refs/heads/release   # or "any" to allow every branch of the repository

# --- Resource names ---
GCP_SERVICE_NAME=bejo
ARTIFACT_REGISTRY_REPO=bejo
CLOUD_SQL_INSTANCE_NAME=bejo-db
CLOUD_SQL_DB_NAME=bejo
CLOUD_SQL_DB_USER=bejo
# Daily automated backup window, UTC (default 19:00 = 02:00 WIB). init-gcp.sh turns backups on.
# CLOUD_SQL_BACKUP_START_TIME=19:00
CLOUD_RUN_SA=bejo-cloudrun          # service account for the running app
GITHUB_ACTIONS_SA=bejo-github-actions  # service account for CI/CD

# --- Ad-campaign audio (Cloud Storage) ---
# Bucket holding the ≤10s voice files. init-gcp.sh creates it (locked down; served
# via signed URLs) and grants the Cloud Run SA access. Defaults to <project>-ads.
ADS_GCS_BUCKET=          # e.g. my-project-ads (blank = <GCP_PROJECT_ID>-ads)
# ADS_SIGNED_URL_TTL_SECONDS=86400  # download-link lifetime in seconds (default 24h; GCS max 7d)
# ADS_MAX_AUDIO_BYTES=2097152       # max audio size, default 2 MB
# ADS_MAX_AUDIO_SECONDS=10          # max audio duration, default 10s
# Gates the ads admin surface (X-ADS-ADMIN-TOKEN); blank = feature off. init-gcp.sh stores this
# in Secret Manager (bejo-ads-admin-token) and mounts it into Cloud Run; the deploy workflow
# references that same secret. Generate: openssl rand -hex 32
# Leaving it blank also means the secret doesn't exist, so set the GitHub Actions variable
# MOUNT_ADS_ADMIN_TOKEN=false too, or CI deploys fail trying to mount it.
ADS_ADMIN_TOKEN=

# --- Voice-converter models (Cloud Storage) ---
# Bucket holding the ONNX files the app downloads to clone a voice on the phone ("Suara Kamu Sendiri").
# init-gcp.sh creates it (locked down, same as the ads bucket; served via signed URLs) and lets the
# Cloud Run SA read it. Defaults to <project>-voice-models.
VOICE_MODELS_GCS_BUCKET=   # e.g. my-project-voice-models (blank = <GCP_PROJECT_ID>-voice-models)

# --- "Say the sale": Gemini on Vertex AI (all optional) ---
# POST /api/voice/transaction sends the recording to Gemini. init-gcp.sh enables aiplatform.googleapis.com and grants the
# Cloud Run SA roles/aiplatform.user; the project is GCP_PROJECT_ID. Defaults apply when these are blank. The model must be a
# current Flash model that accepts audio (gemini-2.5-flash retires 2026-10-20); check a model/location with
# scripts/smoke-voice-transaction.sh before changing them. Set the same names as GitHub Actions variables for CI deploys.
# VOICE_TRANSACTION_MODEL=gemini-3.5-flash
# VOICE_TRANSACTION_LOCATION=global
# VOICE_TRANSACTION_TIMEOUT_SECONDS=12          # seconds to wait for Gemini. Must stay BELOW CLOUD_RUN_TIMEOUT (default 15 s, below): the call
#                                               has to give up and answer 503 before the platform cuts the request. Raise CLOUD_RUN_TIMEOUT first.
# VOICE_TRANSACTION_THINKING_LEVEL=LOW          # MINIMAL | LOW | MEDIUM | HIGH (Gemini 3 thinks by default = slow). Unverified against the live API:
#                                               if a model answers 400 to it, set NONE (blank cannot be deployed: empty values are skipped) to leave the field out
# VOICE_TRANSACTION_MAX_REQUESTS_PER_MINUTE=6   # per user, every call is billed
# VOICE_TRANSACTION_MAX_REQUESTS_PER_DAY=100    # per user

# Shared secret the QRIS payment provider must send as the X-Callback-Secret header on callbacks;
# without it anyone who can reach /snap/** can forge a payment notification. Generate:
# openssl rand -hex 32. Blank = callback unauthenticated (the app warns at startup). init-gcp.sh
# stores it in Secret Manager (bejo-callback-secret). Give the provider the value BEFORE enabling
# the mount for release deploys with the GitHub variable MOUNT_CALLBACK_SECRET=true.
CALLBACK_SECRET=

# --- Outgoing email: password reset codes (Zoho Mail SMTP) ---
# Leave MAIL_PASSWORD blank to keep password reset off (/api/auth/forgot-password answers 503).
# Host depends on the Zoho PLAN and data centre. US: smtp.zoho.com for FREE accounts, smtppro.zoho.com for PAID
# accounts (using the wrong one fails login with "554 5.7.8 Access Restricted"). Other data centres:
# smtp.zoho.eu / .in / .com.au / .jp (and smtppro.* for paid). Your own Settings -> Mail Accounts -> SMTP page is authoritative.
# Port 587 + STARTTLS (default). For 465 instead: MAIL_PORT=465, MAIL_SSL=true, MAIL_STARTTLS=false.
# With two-factor authentication on the Zoho account, MAIL_PASSWORD must be an APPLICATION-SPECIFIC
# password (Zoho Accounts -> Security -> App Passwords), not the login password.
# MAIL_FROM must be the mailbox itself or one of its aliases (Zoho rejects any other sender).
# init-gcp.sh stores MAIL_PASSWORD in Secret Manager (bejo-mail-password); then set the GitHub variables
# MAIL_HOST / MAIL_USERNAME / MAIL_FROM and MOUNT_MAIL_PASSWORD=true so release deploys keep it.
MAIL_HOST=
MAIL_USERNAME=
MAIL_PASSWORD=
# MAIL_FROM=
# MAIL_FROM_NAME=Bejo
# MAIL_PORT=587

# --- Admin dashboard (https://dashboard.bejo.temanproduk.com) ---
# Comma-separated email addresses that may sign in to the dashboard with a one-time code emailed to
# them. Empty = nobody can sign in. Needs the MAIL_* settings above (the code is sent by email).
# For release deploys also set the GitHub variable ADMIN_EMAILS (gh variable set ADMIN_EMAILS ...).
ADMIN_EMAILS=
# Browser origins allowed to call /api/admin/** (CORS). Default: https://dashboard.bejo.temanproduk.com
# ADMIN_DASHBOARD_ORIGINS=

# --- Cloud Run sizing ---
CLOUD_RUN_MIN_INSTANCES=0           # scales to zero when idle (no cost)
CLOUD_RUN_MAX_INSTANCES=2
CLOUD_RUN_MEMORY=512Mi
CLOUD_RUN_CPU=1
CLOUD_RUN_TIMEOUT=15                 # request timeout in seconds (default 15, max 3600)
# true (default) bills CPU only while a request is handled. Work after the response — the FCM push
# queue — then gets almost no CPU, which can delay payment alerts. false keeps CPU allocated (costs more).
# CLOUD_RUN_CPU_THROTTLING=true

# --- Sensitive app secrets (used by init script to populate Secret Manager) ---
# Do NOT commit these; fill them in locally before running init-gcp.sh
DB_PASSWORD=
JWT_SECRET=          # base64, min 256 bits: openssl rand -base64 32
API_TOKEN=
# Push (FCM): by default the service sends as its own service account in the Firebase project FIREBASE_PROJECT_ID
# (default: GCP_PROJECT_ID) — no key needed, and organizations that forbid downloadable keys work. Add Firebase to
# the GCP project and register the Android app there. Only if you must use a key instead (e.g. the Firebase
# project is elsewhere): fill FIREBASE_CREDENTIALS_BASE64 and set MOUNT_FIREBASE_CREDENTIALS=true (also as a GitHub variable).
# FIREBASE_PROJECT_ID=
# FIREBASE_CREDENTIALS_BASE64=   # base64-encoded service account JSON
# MOUNT_FIREBASE_CREDENTIALS=true
SEED_PASSWORD=
SEED_USERNAME=admin
SEED_NAME="Admin User"
# The seed admin's email (verified at creation; login needs a verified email). Default: anton.rifco@gmail.com
SEED_EMAIL=
SEED_BUSINESS_NAME="My Business"
SEED_BUSINESS_ADDRESS=
SEED_NMID=
SEED_MERCHANT_PAN=

# --- Optional overrides (built-in defaults apply if unset) ---
# Read by init-gcp.sh for the first deploy. For subsequent CI deploys, set the SAME
# names as GitHub Actions *variables* (Settings → Variables → Actions) — deploy.yml
# forwards them to scripts/deploy-cloud-run.sh (as it does the CLOUD_RUN_* sizing above).
# Uncomment to override. Comma-separated lists validated at registration.
# JWT_EXPIRATION_MS=604800000
# BUSINESS_MAX_USERS=10
# BUSINESS_SIZES=Mikro,Kecil,Menengah,Besar,Non-Profit
# BUSINESS_DEFAULT_SIZE=Mikro
# BUSINESS_INDUSTRIES="Makanan & Minuman,Otomotif,Event & Hiburan,Alat Tulis/Kantor,Peralatan Rumah Tangga,Pakaian & Aksesoris,Kesehatan & Kecantikan,Layanan Keuangan,SPBU,Pendidikan,Asuransi"
# BUSINESS_DEFAULT_INDUSTRY="Makanan & Minuman"
# CALLBACK_DEFAULT_USERNAME=admin
# A callback whose merchantPan is missing/unknown is rejected (404) by default. Set true only to
# restore the old behaviour of attributing it to the default account (used by CALLBACK_DEFAULT_USERNAME).
# CALLBACK_FALLBACK_TO_DEFAULT=false
# LOGIN_MAX_FAILURES=10              # consecutive failed logins per username before lockout
# LOGIN_LOCKOUT_MINUTES=15           # how long a locked account waits
# MAX_REQUEST_BYTES=8388608          # max request body (413 above it), default 8 MB
# DB_POOL_SIZE=10                    # JDBC pool per instance; keep pool x CLOUD_RUN_MAX_INSTANCES under the DB's max_connections
# JAVA_OPTS=-XX:MaxRAMPercentage=75  # replaces the JVM flags; lower the % if Cloud Run kills the container for memory
# PUSH_QUEUE_THREADS=4               # FCM delivery worker pool size
# PUSH_QUEUE_CAPACITY=1000           # FCM delivery queue capacity
# REQUEST_LOG_BODY_ON_ERROR=true
# REQUEST_LOG_MAX_BODY_LENGTH=2048
