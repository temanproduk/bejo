# GCP project configuration — copy to .env.gcp and fill in all values
# .env.gcp is gitignored (it contains sensitive values)

# --- Project ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-southeast2          # Jakarta

# --- Custom domain ---
# Must be verified in Google Search Console before running init-gcp.sh
# https://search.google.com/search-console
CUSTOM_DOMAIN=api.bejo.temanproduk.com

# --- Resource names ---
GCP_SERVICE_NAME=bejo
ARTIFACT_REGISTRY_REPO=bejo
CLOUD_SQL_INSTANCE_NAME=bejo-db
CLOUD_SQL_DB_NAME=bejo
CLOUD_SQL_DB_USER=bejo
CLOUD_RUN_SA=bejo-cloudrun          # service account for the running app
GITHUB_ACTIONS_SA=bejo-github-actions  # service account for CI/CD

# --- Ad-campaign audio (Cloud Storage) ---
# Bucket holding the ≤10s voice files. init-gcp.sh creates it (locked down; served
# via signed URLs) and grants the Cloud Run SA access. Defaults to <project>-ads.
ADS_GCS_BUCKET=          # e.g. bejo-prod-ads (blank = <GCP_PROJECT_ID>-ads)
# ADS_SIGNED_URL_TTL_SECONDS=86400  # download-link lifetime in seconds (default 24h; GCS max 7d)
# ADS_MAX_AUDIO_BYTES=2097152       # max audio size, default 2 MB
# ADS_MAX_AUDIO_SECONDS=10          # max audio duration, default 10s
# Gates the ads admin surface (X-ADS-ADMIN-TOKEN); blank = feature off. init-gcp.sh stores this
# in Secret Manager (bejo-ads-admin-token) and mounts it into Cloud Run; the deploy workflow
# references that same secret. Generate: openssl rand -hex 32
ADS_ADMIN_TOKEN=

# --- Cloud Run sizing ---
CLOUD_RUN_MIN_INSTANCES=0           # scales to zero when idle (no cost)
CLOUD_RUN_MAX_INSTANCES=2
CLOUD_RUN_MEMORY=512Mi
CLOUD_RUN_CPU=1
CLOUD_RUN_TIMEOUT=30                 # request timeout in seconds (default 30, max 3600)

# --- Sensitive app secrets (used by init script to populate Secret Manager) ---
# Do NOT commit these; fill them in locally before running init-gcp.sh
DB_PASSWORD=
JWT_SECRET=          # base64, min 256 bits: openssl rand -base64 32
API_TOKEN=
FIREBASE_CREDENTIALS_BASE64=   # base64-encoded service account JSON
SEED_PASSWORD=
SEED_USERNAME=admin
SEED_NAME=Admin User
SEED_BUSINESS_NAME=My Business
SEED_BUSINESS_ADDRESS=
SEED_NMID=

# --- Optional overrides (built-in defaults apply if unset) ---
# Read by init-gcp.sh for the first deploy. For subsequent CI deploys, set the SAME
# names as GitHub Actions *variables* (Settings → Variables → Actions) — deploy.yml
# picks them up there. Uncomment to override. Comma-separated lists validated at registration.
# JWT_EXPIRATION_MS=604800000
# BUSINESS_MAX_USERS=10
# BUSINESS_SIZES=Mikro,Kecil,Menengah,Besar,Non-Profit
# BUSINESS_DEFAULT_SIZE=Mikro
# BUSINESS_INDUSTRIES=Makanan & Minuman,Otomotif,Event & Hiburan,Alat Tulis/Kantor,Peralatan Rumah Tangga,Pakaian & Aksesoris,Kesehatan & Kecantikan,Layanan Keuangan,SPBU,Pendidikan,Asuransi
# BUSINESS_DEFAULT_INDUSTRY=Makanan & Minuman
# CALLBACK_DEFAULT_USERNAME=admin
# REQUEST_LOG_BODY_ON_ERROR=true
# REQUEST_LOG_MAX_BODY_LENGTH=2048
